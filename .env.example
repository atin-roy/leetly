# PostgreSQL
POSTGRES_USER=leetly
POSTGRES_PASSWORD=change_me

# Signing key for the access tokens the API issues.
# Must be at least 32 bytes. Generate with: openssl rand -base64 48
APP_JWT_SECRET=generate_with___openssl_rand_-base64_48

# Token lifetimes (ISO-8601 durations)
APP_JWT_ACCESS_TTL=PT15M
APP_JWT_REFRESH_TTL=P30D

# Frontend -> API base URL (inlined into the client bundle during the web build)
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# Server-side API URL used by the web container for auth calls.
# In Docker this is the container-reachable address.
API_URL=http://leetly-api:8080

# CORS: comma-separated origins allowed to call the backend from a browser.
# Must include every frontend origin.
APP_CORS_ALLOWED_ORIGINS=https://yourdomain.com
